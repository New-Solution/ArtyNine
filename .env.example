# ---------------------------------------------------------------------------
# Supabase (Stage 1b: authentication). Both values are safe for the browser.
# Project Settings -> API in the Supabase dashboard.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# NEVER put the service_role key in this file or anywhere in frontend code.
# It bypasses Row Level Security. The one-time Super Admin seed script reads it
# from your shell environment instead:
#   SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... npm run create-super-admin

# ---------------------------------------------------------------------------
# One domain for customers and staff (app.artybooking.com). "Staff Login"
# opens the console in the same tab on whatever domain the visitor is on and
# adds ?staff to the URL so a refresh stays in the console.
#
# VITE_CUSTOMER_SITE_URL is used only on a dedicated staff hostname
# (staff.artybooking.com), where "View Customer Site" sends the browser to it.
# Production: https://app.artybooking.com  — leave unset for local dev.
# (VITE_STAFF_SITE_URL is no longer read; remove it.)
# ---------------------------------------------------------------------------
VITE_CUSTOMER_SITE_URL=""

# ---------------------------------------------------------------------------
# Cloudflare Turnstile site key for Supabase Auth CAPTCHA (public, safe for
# the browser). Leave unset until CAPTCHA is switched on in Supabase
# (Authentication -> Attack Protection, with the matching secret key): while
# unset no widget is shown and no captcha token is sent.
# ---------------------------------------------------------------------------
VITE_TURNSTILE_SITE_KEY=""
